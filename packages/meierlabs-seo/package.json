{
	"name": "meierlabs-seo",
	"version": "0.1.0-alpha.0",
	"description": "Crelte frontend for the Meier Labs SEO Craft CMS plugin: head tags, sitemaps and robots.txt.",
	"author": "S\u00f6ren Meier",
	"license": "SEE LICENSE IN LICENSE.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soerenmeier/craft-meierlabs-seo.git",
		"directory": "packages/meierlabs-seo"
	},
	"type": "module",
	"files": [
		"dist",
		"src",
		"LICENSE.md"
	],
	"scripts": {
		"check": "svelte-check",
		"build": "svelte-package -i ./src",
		"watch": "svelte-package -i ./src -w",
		"prepack": "npm run build",
		"check-fmt": "prettier -c .",
		"fmt": "prettier -w ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		}
	},
	"peerDependencies": {
		"crelte": "^0.5.0 || ^0.6.0-alpha.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"crelte": "^0.6.0-alpha.2",
		"prettier": "^3.3.0",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^8.0.0"
	}
}
