{% extends 'meierlabs-seo/_layout' %}
{% import '_includes/forms' as forms %}

{% set title = 'Global SEO'|t('meierlabs-seo') %}
{% set selectedSubnavItem = 'global' %}
{% set fullPageForm = true %}

{% block content %}
	{{ actionInput('meierlabs-seo/cp/save-global') }}
	{{ redirectInput('meierlabs-seo/global?site=' ~ site.handle) }}
	{{ hiddenInput('siteId', site.id) }}

	{% if not isPrimary %}
		<p class="readable light">{{ 'Empty fields use the values of the primary site, except the description and robots.txt.'|t('meierlabs-seo') }}</p>
	{% endif %}

	{% if not indexingAllowed %}
		<div class="readable" style="margin-bottom: 24px">
			<p class="warning with-icon">
				{{ 'Search engines are blocked in this environment ({env}): every page gets noindex, nofollow and robots.txt disallows everything. Indexing is only allowed in production, change it with allowIndexing in config/meierlabs-seo.php.'|t('meierlabs-seo', {env: craft.app.env}) }}
			</p>
		</div>
	{% endif %}

	{{ forms.textField({
		label: 'Site Name'|t('meierlabs-seo'),
		instructions: 'Used in titles (`{siteName}`), og:site_name and the structured data.'|t('meierlabs-seo'),
		name: 'settings[siteName]',
		value: data.siteName ?? '',
		placeholder: defaults.siteName,
	}) }}

	{{ forms.textField({
		label: 'Title Pattern'|t('meierlabs-seo'),
		instructions: 'How page titles are built.'|t('meierlabs-seo') ~ ' ' ~ include('meierlabs-seo/_includes/patternHelp'),
		name: 'settings[titlePattern]',
		value: data.titlePattern ?? '',
		placeholder: defaults.titlePattern,
		class: 'code',
	}) }}

	{{ forms.textareaField({
		label: 'Description'|t('meierlabs-seo'),
		instructions: 'Used when neither the entry, its entry type nor its section has one. About 150 characters.'|t('meierlabs-seo'),
		name: 'settings[description]',
		value: data.description ?? '',
		rows: 3,
		inputAttributes: {
			data: {'mlseo-count': 160},
		},
	}) }}

	{{ forms.elementSelectField({
		label: 'Image'|t('meierlabs-seo'),
		instructions: 'Shown when the page is shared, cropped to 1200×630.'|t('meierlabs-seo'),
		name: 'settings[imageId]',
		elementType: 'craft\\elements\\Asset',
		criteria: {kind: ['image']},
		limit: 1,
		elements: image ? [image] : [],
		viewMode: 'large',
	}) }}

	{{ forms.selectField({
		label: 'Robots'|t('meierlabs-seo'),
		instructions: 'The default for all pages.'|t('meierlabs-seo'),
		name: 'settings[robots]',
		options: robotsOptions,
		value: data.robots ?? (isPrimary ? 'index, follow' : ''),
	}) }}

	{{ forms.textField({
		label: 'X (Twitter) Handle'|t('meierlabs-seo'),
		name: 'settings[twitterHandle]',
		value: data.twitterHandle ?? '',
		placeholder: '@handle',
	}) }}

	<hr>

	{{ forms.textareaField({
		label: 'robots.txt'|t('meierlabs-seo'),
		instructions: 'Rules for `/robots.txt` of this site’s domain (the primary site of a domain wins). Empty allows everything. The sitemap line is added automatically.'|t('meierlabs-seo'),
		name: 'settings[robotsTxt]',
		value: data.robotsTxt ?? '',
		rows: 5,
		class: 'code',
		placeholder: "User-agent: *\nDisallow:",
	}) }}
{% endblock %}
