{% extends 'meierlabs-seo/_layout' %}
{% import '_includes/forms' as forms %}

{% set title = section.name|t('site') %}
{% set selectedSubnavItem = 'sections' %}
{% set fullPageForm = true %}
{% set crumbs = [
	{label: 'SEO'|t('meierlabs-seo'), url: cpUrl('meierlabs-seo')},
	{label: 'Sections'|t('meierlabs-seo'), url: cpUrl('meierlabs-seo/sections', {site: site.handle})},
] %}

{% block content %}
	{{ actionInput('meierlabs-seo/cp/save-section') }}
	{{ redirectInput('meierlabs-seo/sections?site=' ~ site.handle) }}
	{{ hiddenInput('siteId', site.id) }}
	{{ hiddenInput('section', section.handle) }}

	<p class="readable light">{{ 'Empty fields use the global settings.'|t('meierlabs-seo') }}</p>

	{{ forms.lightswitchField({
		label: 'Include in Sitemap'|t('meierlabs-seo'),
		instructions: 'Entries with `noindex` or a canonical URL to another page are always left out.'|t('meierlabs-seo'),
		name: 'settings[sitemap]',
		on: data.sitemap ?? true,
	}) }}

	{{ forms.selectField({
		label: 'Robots'|t('meierlabs-seo'),
		name: 'settings[robots]',
		options: robotsOptions,
		value: data.robots ?? '',
	}) }}

	{{ forms.textField({
		label: 'Title Pattern'|t('meierlabs-seo'),
		instructions: include('meierlabs-seo/_includes/patternHelp'),
		name: 'settings[titlePattern]',
		value: data.titlePattern ?? '',
		placeholder: globals.titlePattern,
		class: 'code',
	}) }}

	{{ forms.textareaField({
		label: 'Description'|t('meierlabs-seo'),
		name: 'settings[description]',
		value: data.description ?? '',
		placeholder: globals.description,
		rows: 3,
		inputAttributes: {
			data: {'mlseo-count': 160},
		},
	}) }}

	{{ forms.elementSelectField({
		label: 'Image'|t('meierlabs-seo'),
		name: 'settings[imageId]',
		elementType: 'craft\\elements\\Asset',
		criteria: {kind: ['image']},
		limit: 1,
		elements: image ? [image] : [],
		viewMode: 'large',
	}) }}
{% endblock %}
