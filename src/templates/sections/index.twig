{% extends 'meierlabs-seo/_layout' %}

{% set title = 'Sections' %}
{% set selectedSubnavItem = 'sections' %}

{% block content %}
	<p class="readable light">
		Overrides for all entries of a section. Entry types and the SEO field of an entry override them again.
	</p>

	<table class="data fullwidth">
		<thead>
			<tr>
				<th>Section</th>
				<th>Sitemap</th>
				<th>Robots</th>
				<th>Title Pattern</th>
				<th>Description</th>
				<th>Image</th>
			</tr>
		</thead>
		<tbody>
			{% for row in rows %}
				{% set data = row.data %}
				<tr>
					<th>
						<a href="{{ cpUrl('meierlabs-seo/sections/' ~ row.section.handle, {site: site.handle}) }}">{{ row.section.name|t('site') }}</a>
					</th>
					<td>{% if data.sitemap ?? true %}Yes{% else %}<span class="light">No</span>{% endif %}</td>
					<td>{% if data.robots ?? false %}{{ data.robots }}{% else %}<span class="light">Inherit</span>{% endif %}</td>
					<td><code>{{ data.titlePattern ?? '' }}</code></td>
					<td>{{ (data.description ?? false) ? '✓' }}</td>
					<td>{{ (data.imageId ?? false) ? '✓' }}</td>
				</tr>
			{% else %}
				<tr><td colspan="6" class="light">No sections with URLs.</td></tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
